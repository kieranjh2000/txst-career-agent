# Copy this file to ".env" (in the same folder) and fill in your real key.
# Do NOT commit your actual .env file anywhere -- it contains a secret.

GEMINI_API_KEY=your_key_here

# Optional: override which Gemini model is used first (defaults to
# gemini-3.5-flash-lite, which has a higher free-tier daily quota)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: backup model used automatically if the primary one is
# overloaded, unavailable, or has hit its daily quota
# (defaults to gemini-3.6-flash)
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional: Access code for restricted test environment in web deployment
# Defaults to BOBCATS2026 if not set
APP_ACCESS_CODE=BOBCATS2026

# Optional: Staff PIN for FERPA-protected Role-Based Access Control (RBAC)
# Required for Career Services staff/evaluators to view and download student records
# Defaults to TXSTSTAFF2026 if not set
APP_STAFF_CODE=TXSTSTAFF2026
